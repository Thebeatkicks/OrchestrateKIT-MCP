{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orchestratemcp.dev/orchestratedash/contracts/agent.manifest.v2.schema.json",
  "title": "OrchestrateDASH agent manifest v2",
  "description": "Additive v2 manifest. It preserves the telemetry v1 fields and adds an Agent DOM declaration. Unknown fields remain forward-compatible. Credential values are forbidden; connection fields describe requirements only.",
  "type": "object",
  "required": ["manifest_version", "agent", "planned_route", "safety_contract", "monitoring", "provenance", "agent_dom"],
  "properties": {
    "manifest_version": { "const": 2 },
    "agent": {
      "type": "object",
      "required": ["name", "goal", "plan_source", "playbook_id", "route_id", "build_target"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "goal": { "type": "string", "minLength": 1 },
        "plan_source": { "enum": ["playbook", "composed"] },
        "playbook_id": { "type": "string" },
        "route_id": { "type": "string" },
        "build_target": { "enum": ["cowork", "cursor", "chatgpt_gpt", "code"] }
      }
    },
    "planned_route": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "component_id", "risk_level", "model_tier"],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "component_id": { "type": "string", "minLength": 1 },
          "risk_level": { "enum": ["low", "medium", "high", "critical"] },
          "model_tier": { "enum": ["none", "small", "standard", "frontier"] }
        }
      }
    },
    "safety_contract": {
      "type": "object",
      "required": ["automation_clearance", "enforced_approval_gates", "irreversible_components"],
      "properties": {
        "automation_clearance": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "enforced_approval_gates": { "type": "array", "items": { "type": "string" } },
        "irreversible_components": { "type": "array", "items": { "type": "string" } }
      }
    },
    "monitoring": {
      "type": "object",
      "required": ["events", "endpoint_env", "token_env", "output_location"],
      "properties": {
        "events": {
          "type": "array",
          "items": { "enum": ["run_started", "step_started", "step_completed", "gate_requested", "gate_resolved", "run_completed", "run_failed"] }
        },
        "endpoint_env": { "type": "string" },
        "token_env": { "type": "string" },
        "output_location": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["generated_by", "registry_fingerprint", "generated_at"],
      "properties": {
        "generated_by": { "type": "string" },
        "registry_fingerprint": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" }
      }
    },
    "agent_dom": {
      "type": "object",
      "required": ["dom_version", "runtime", "trigger", "locations", "connections", "control", "memory"],
      "properties": {
        "dom_version": { "const": 1 },
        "runtime": {
          "type": "object",
          "required": ["class", "label", "availability", "continues_when_dash_closed"],
          "properties": {
            "class": { "enum": ["local_process", "managed_worker", "scheduled_job", "workflow_platform", "client_session", "other"] },
            "provider": { "type": "string" },
            "label": { "type": "string", "minLength": 1 },
            "availability": { "enum": ["always_on", "scheduled", "while_client_open", "on_demand", "unknown"] },
            "continues_when_dash_closed": { "type": "boolean" }
          }
        },
        "trigger": {
          "type": "object",
          "required": ["type", "label"],
          "properties": {
            "type": { "enum": ["manual", "schedule", "webhook", "event", "poll", "client_session", "other"] },
            "label": { "type": "string", "minLength": 1 },
            "schedule": { "type": "string" },
            "technical": { "type": "object" },
            "expected_interval_seconds": {
              "description": "The longest gap DASH should expect between this agent's activity before treating it as stalled rather than quietly idle. Optional and meaningful only alongside type \"schedule\": schedule is free text (\"weekdays at 08:00 local time\") and DASH does not parse it, so an absent value means no expectation can be derived and this agent is never marked stalled.",
              "type": "number",
              "minimum": 1
            }
          }
        },
        "locations": {
          "type": "object",
          "required": ["runtime", "control", "interaction"],
          "properties": {
            "runtime": { "$ref": "#/$defs/location" },
            "control": { "type": "array", "items": { "$ref": "#/$defs/location" } },
            "interaction": { "type": "array", "items": { "$ref": "#/$defs/location" } }
          }
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "#/$defs/connectionRequirement" }
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "task_inputs": {
          "type": "array",
          "description": "What files this agent accepts as a task, declared per role (MAR-434). Optional, and absent means the agent takes no files — which is every agent shipped before this block existed, so absence must never be read as an unrestricted agent. The declaration is what the runner narrows its own ceilings down to; it can never widen them, so a manifest asking for a 4 GiB input gets the runner's limit and a refusal, not 4 GiB. See runner/workspace.ts effectiveLimits.",
          "items": { "$ref": "#/$defs/taskInputRole" }
        },
        "control": {
          "type": "object",
          "required": ["supported", "command_version", "commands"],
          "properties": {
            "supported": { "type": "boolean" },
            "command_version": { "const": 1 },
            "location_id": { "type": "string" },
            "commands": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["approve", "reject", "choose", "retry", "pause", "resume", "cancel"] }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "supported": { "const": false } }, "required": ["supported"] },
              "then": { "properties": { "commands": { "type": "array", "maxItems": 0 } } }
            }
          ]
        },
        "memory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "description", "visibility", "retention"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "visibility": { "const": "user_visible" },
              "retention": { "enum": ["descriptor_only", "user_approved"] }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "taskInputRole": {
      "type": "object",
      "description": "One kind of file a task accepts, in the user's vocabulary (MAR-434).\n\nA role rather than a slot number, because the surface says \"Customer brief\" and \"Price list\" and a person selects against those words. `id` is what a command carries and never what a person reads — the split `permissionGrant` already makes, for the same reason.\n\n**Media types are checked against sniffed bytes, not against the extension.** An extension is a claim by whoever named the file; `runner/workspace.ts` reads the first bytes and refuses a mismatch. So declaring `application/pdf` here means the runner will refuse a renamed executable, and declaring nothing means the runner does not narrow — which is honest but is not the same as accepting anything, because the runner's own ceilings still apply.",
      "required": ["id", "label", "required"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$",
          "description": "Technical vocabulary, e.g. `customer_brief`. Carried in commands; never rendered on a guided surface."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "What a person reads, e.g. \"Customer brief\". Held to lib/copy/identifiers.ts."
        },
        "description": {
          "type": "string",
          "maxLength": 400,
          "description": "Why this agent wants it. Rendered beside the file picker so a person can tell whether they are handing over the right document."
        },
        "required": {
          "type": "boolean",
          "description": "Whether the task can start without it. Required rather than optional in the schema because a renderer that has to guess would guess `false` and let a task start missing the file it exists to read."
        },
        "min_count": { "type": "integer", "minimum": 0 },
        "max_count": {
          "type": "integer",
          "minimum": 1,
          "description": "The runner lowers this to its own ceiling and never raises it."
        },
        "media_types": {
          "type": "array",
          "description": "Accepted types as the runner sniffs them, e.g. `application/pdf`. Absent means the runner does not narrow by type. Note that DASH does not open a ZIP container to tell a .docx from a .xlsx, so both are `application/zip` — declaring one and not the other narrows nothing.",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Per file. Lowered to the runner's ceiling, never raised past it."
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Across every file in this role. Lowered to the runner's ceiling, never raised past it."
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "What the agent declares it may do that needs no credential — the case `connections` cannot express, because every connection requirement carries an owner, fields and a validation action. Additive and optional: a manifest without this block declares nothing, which is different from declaring nothing is needed.\n\nThe shape deliberately mirrors the OrchestrateKit registry's component `permissions` block (read / write / approval_required_for) so a scaffolded manifest and an exported build brief describe a permission the same way. A second vocabulary here would mean the two documents could disagree about the same grant.\n\n**This is a declaration, not a boundary.** The runner strips the environment (`runner/supervisor.ts`) but spawns an ordinary child process with unrestricted network access. DASH renders what the agent claims and who to ask about it; it does not enforce it, and no copy built on this block may say that it does. The same honesty ADR 0002 requires of the draft-only Gmail boundary applies here.",
      "properties": {
        "read": { "type": "array", "items": { "$ref": "#/$defs/permissionGrant" } },
        "write": { "type": "array", "items": { "$ref": "#/$defs/permissionGrant" } },
        "approval_required_for": { "type": "array", "items": { "$ref": "#/$defs/permissionGrant" } }
      }
    },
    "permissionGrant": {
      "type": "object",
      "required": ["id", "label", "detail"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The registry's own name for the capability, e.g. `network`. Technical vocabulary: a guided surface renders `label`, never this."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "What it may do, in the words a person reads. Held to lib/copy/identifiers.ts."
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "The scope of the grant in plain language — what is included and what is not."
        }
      }
    },
    "location": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["local", "remote", "provider_ui", "dash", "client", "other"] },
        "uri": { "type": "string", "format": "uri-reference" },
        "offline_behavior": { "type": "string", "minLength": 1 }
      }
    },
    "connectionRequirement": {
      "type": "object",
      "propertyNames": {
        "not": { "enum": ["value", "secret", "password", "token", "access_token", "refresh_token", "client_secret", "api_key", "credential_value"] }
      },
      "required": ["id", "provider", "label", "purpose", "ownership", "capabilities", "fields", "validation_action"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "ownership": { "enum": ["dash_managed", "agent_managed", "external"] },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "label", "access"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "access": { "enum": ["read", "write"] },
              "technical": { "type": "object" }
            }
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "propertyNames": {
              "not": { "enum": ["value", "secret", "password", "token", "access_token", "refresh_token", "client_secret", "api_key", "credential_value"] }
            },
            "required": ["id", "label", "purpose", "kind", "required"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["secret", "non_secret", "oauth_reauthorization"] },
              "required": { "type": "boolean" },
              "help": { "type": "string" },
              "technical": {
                "type": "object",
                "properties": {
                  "environment_name": { "type": "string" },
                  "provider_scopes": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "validation_action": {
          "type": "object",
          "required": ["id", "label", "behavior"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "behavior": { "enum": ["test", "reconnect_test_switch"] }
          }
        }
      }
    }
  }
}
