# MAR-504: pin all text files to LF, both stored and on checkout. Without
# eol=lf, core.autocrlf=true on Windows checks files out as CRLF, and any
# byte-for-byte comparison against LF-generated content (e.g. the protocol
# conformance matrix) fails even though the content is identical.
* text=auto eol=lf

.claude/ export-ignore
.claude/** export-ignore
.claude/settings.local.json export-ignore
.env* export-ignore
**/.env* export-ignore
.wrangler/ export-ignore
.wrangler/** export-ignore
dist/ export-ignore
dist/** export-ignore
.next/ export-ignore
.next/** export-ignore
.labos/ export-ignore
.labos/** export-ignore
node_modules/ export-ignore
node_modules/** export-ignore
*.db export-ignore
**/*.db export-ignore
*.sqlite export-ignore
**/*.sqlite export-ignore
*.log export-ignore
**/*.log export-ignore
logs/ export-ignore
logs/** export-ignore
ai-agent-briefing-* export-ignore
exports/ export-ignore
exports/** export-ignore
